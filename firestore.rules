rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "samergafer22@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user to initialize/update their own profile, or full admin control
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // System Configuration
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Global Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Word Bank Custom Overrides
    match /word_bank_overrides/{wordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Matches collection
    match /matches/{matchId} {
      // Any authenticated user can read match (needed for invites by code, or participating)
      allow read: if isAuthenticated();
      
      // Allow match creation if creator is current auth user or admin
      allow create: if isAuthenticated() && 
                    (request.resource.data.creatorId == request.auth.uid || 
                     request.auth.uid in request.resource.data.players ||
                     isAdmin());
                     
      // Allow updates if user is a participant or joining the match or admin
      allow update: if isAuthenticated() && 
                    (isAdmin() ||
                     request.auth.uid in resource.data.players || 
                     request.auth.uid == resource.data.creatorId ||
                     resource.data.guestId == null ||
                     resource.data.guestId == "" ||
                     request.resource.data.guestId == request.auth.uid);
                     
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.creatorId || isAdmin());
    }

    // Matchmaking queue
    match /matchmaking/{queueId} {
      allow read, write: if isAuthenticated();
    }

    // Daily & Weekly Challenges
    match /daily_challenges/{dateKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /participants/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /weekly_challenges/{weekKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /participants/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Daily & Weekly User Tasks
    match /user_tasks/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}

