rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "samergafer22@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isUserBanned(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.isBanned == true;
    }

    // Admins Collection - Restricted to verified administrators
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles - Read is public for leaderboards/matches; write is strictly scoped
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        ((isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId.matches('^guest_.*'))) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned != true)
      );
      allow update: if isAdmin() || (
        ((isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId.matches('^guest_.*'))) &&
        // Non-admins cannot escalate privileges or unban accounts
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isBanned'])) &&
        // Banned accounts cannot update their profiles
        (!('isBanned' in resource.data) || resource.data.isBanned != true)
      );
      allow delete: if isAdmin() || ((isAuthenticated() && request.auth.uid == userId) && (!('isBanned' in resource.data) || resource.data.isBanned != true));
    }

    // System Configuration - Global settings (read-only for players, write strictly for Admin)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Announcements - Broadcasts (read-only for players, write strictly for Admin)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Word Bank Custom Overrides - Validated contributions or Admin managed
    match /word_bank_overrides/{wordId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.word is string && 
        request.resource.data.word.size() > 0 &&
        request.resource.data.word.size() <= 60 && 
        request.resource.data.letter is string && 
        request.resource.data.letter.size() <= 10 &&
        (!isAuthenticated() || !isUserBanned(request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // Dynamic Learned Lexicon (Crowd-sourced & auto-learned words)
    match /learned_lexicon/{wordId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.word is string && 
        request.resource.data.word.size() > 0 &&
        request.resource.data.word.size() <= 60 && 
        request.resource.data.letter is string && 
        request.resource.data.letter.size() <= 10 &&
        (!isAuthenticated() || !isUserBanned(request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // Matches collection - active match data
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Matchmaking queue - fast open queue
    match /matchmaking/{queueId} {
      allow read, write: if true;
    }

    // Daily & Weekly Challenges
    match /daily_challenges/{dateKey} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{userId} {
        allow read: if true;
        allow write: if isAdmin() || (
          ((isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId.matches('^guest_.*'))) &&
          !isUserBanned(userId)
        );
      }
    }

    match /weekly_challenges/{weekKey} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{userId} {
        allow read: if true;
        allow write: if isAdmin() || (
          ((isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId.matches('^guest_.*'))) &&
          !isUserBanned(userId)
        );
      }
    }

    // Daily & Weekly User Tasks
    match /user_tasks/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (
        ((isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId.matches('^guest_.*'))) &&
        !isUserBanned(userId)
      );
    }
  }
}
