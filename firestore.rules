rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return (
        (isAuthenticated() && request.auth.token.email == "samergafer22@gmail.com") ||
        (isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Configuration
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Word Bank Custom Overrides
    match /word_bank_overrides/{wordId} {
      allow read: if true;
      allow write: if true;
    }

    // Matches collection
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Matchmaking queue
    match /matchmaking/{queueId} {
      allow read, write: if true;
    }

    // Daily & Weekly Challenges
    match /daily_challenges/{dateKey} {
      allow read, write: if true;

      match /participants/{userId} {
        allow read, write: if true;
      }
    }

    match /weekly_challenges/{weekKey} {
      allow read, write: if true;

      match /participants/{userId} {
        allow read, write: if true;
      }
    }

    // Daily & Weekly User Tasks
    match /user_tasks/{userId} {
      allow read, write: if true;
    }
  }
}

