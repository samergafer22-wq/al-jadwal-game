rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "samergafer22@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection - Restricted to verified administrators
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles - Read is public for leaderboards/matches; write is scoped to profile owner or Admin
    match /users/{userId} {
      allow read: if true;
      allow create, update: if (isAuthenticated() && request.auth.uid == userId) 
                            || (!isAuthenticated() && userId.matches('^guest_.*'))
                            || isAdmin();
      allow delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    // System Configuration - Global settings (read-only for players, write strictly for Admin)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Announcements - Broadcasts (read-only for players, write strictly for Admin)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Word Bank Custom Overrides - Validated contributions or Admin managed
    match /word_bank_overrides/{wordId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.word is string && 
        request.resource.data.word.size() <= 60 && 
        request.resource.data.letter is string && 
        request.resource.data.letter.size() <= 10
      );
      allow delete: if isAdmin();
    }

    // Dynamic Learned Lexicon (Crowd-sourced & auto-learned words)
    match /learned_lexicon/{wordId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.word is string && 
        request.resource.data.word.size() <= 60 && 
        request.resource.data.letter is string && 
        request.resource.data.letter.size() <= 10
      );
      allow delete: if isAdmin();
    }

    // Matches collection - active match data (accessible to game participants)
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Matchmaking queue - fast open queue
    match /matchmaking/{queueId} {
      allow read, write: if true;
    }

    // Daily & Weekly Challenges
    match /daily_challenges/{dateKey} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{userId} {
        allow read: if true;
        allow write: if (isAuthenticated() && request.auth.uid == userId)
                     || (!isAuthenticated() && userId.matches('^guest_.*'))
                     || isAdmin();
      }
    }

    match /weekly_challenges/{weekKey} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{userId} {
        allow read: if true;
        allow write: if (isAuthenticated() && request.auth.uid == userId)
                     || (!isAuthenticated() && userId.matches('^guest_.*'))
                     || isAdmin();
      }
    }

    // Daily & Weekly User Tasks
    match /user_tasks/{userId} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == userId)
                   || (!isAuthenticated() && userId.matches('^guest_.*'))
                   || isAdmin();
    }
  }
}
